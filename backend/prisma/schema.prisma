datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

// ─── Auth & Roles ───────────────────────────────────

model User {
  id           String        @id @default(uuid())
  authorityId  String        @unique
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("DISTRICT")
  state        String?       @default("All India")
  district     String?       @default("All Districts")
  createdCases Case[]        @relation("CreatedBy")
  actions      CaseAction[]
  auditLogs    AuditLog[]
  feedback     Feedback[]
  createdAt    DateTime      @default(now())
}

// ─── MPLADS Project (matches master_dataset_scored.csv) ───

model Project {
  id                      String     @id @default(uuid())
  projectId               String     @unique       // work_id from CSV

  // Descriptive
  workType                String?
  workDescription         String?
  state                   String?
  district                String?
  constituency            String?
  mpName                  String?

  // Financial
  recommendedAmount       Float?
  sanctionedAmount        Float?
  totalDisbursed          Float?
  expenditureRatio        Float?
  amountDeviation         Float?
  finalCompletedAmount    Float?

  // Timeline
  recommendationDate      String?
  sanctionDate            String?
  actualCompletionDate    String?
  sanctionDelayDays       Float?
  completionDurationDays  Float?
  workStatus              String?

  // Payments
  paymentCount            Float?
  averagePayment          Float?
  maximumPayment          Float?
  firstPaymentDate        String?
  lastPaymentDate         String?
  paymentDurationDays     Float?

  // Vendor
  vendorName              String?
  vendorCountPerWork      Int?

  // Risk Scores (from ML pipeline)
  riskScore               Float      @default(0)
  riskLevel               String     @default("LOW")
  riskComponents          String?    // JSON string: {"financial":0,"ml":0,...}
  structuredReasons       String?    // JSON string: [{type,evidence,...}]
  riskEvidenceExplanation String?
  aiJustificationSummary  String?

  // Module Specific Risk Scores & Signals
  financialRiskScore      Float?     @default(0)
  financialRiskLevel      String?    @default("LOW")
  financialSignals        String?    // JSON string
  anomalyScore            Float?     @default(0)

  procurementRiskScore    Float?     @default(0)
  procurementRiskLevel    String?    @default("LOW")
  procurementSignals      String?    // JSON string

  contractorRiskScore     Float?     @default(0)
  contractorRiskLevel     String?    @default("LOW")
  contractorSignals       String?    // JSON string

  // ML Signals
  peerMedianAmount        Float?
  peerDeviation           Float?
  ifAnomalySignal         Boolean    @default(false)
  similarWorkDetected     Boolean    @default(false)
  similarWorkId           String?

  // Metadata
  imageAvailable          Boolean    @default(false)
  dataSource              String     @default("MPLADS_ESAKSHI")

  // Relations
  procurements            Procurement[]
  cases                   Case[]
  auditLogs               AuditLog[]
  feedback                Feedback[]
  anomalies               Anomaly[]

  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
}

// ─── Procurement Intelligence ────────────────────────

model Procurement {
  id                  String   @id @default(uuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id])
  uploadedFile        String?
  extractedText       String?
  extractionMethod    String?  // DIGITAL | OCR
  items               String?  // JSON array of extracted items
  procurementRiskScore Float?
  procurementRiskLevel String?
  summary             String?
  status              String?  // Uploaded | Analyzed | Error
  
  // Extracted Metadata
  tenderNumber        String?
  projectName         String?
  issuingAuthority    String?
  contractorVendor    String?
  tenderDate          String?
  totalEstimatedValue Float?
  totalQuotedValue    Float?
  
  createdAt           DateTime @default(now())
}

// ─── Contractor (aggregated from vendor data) ────────

model Contractor {
  id                 String   @id @default(uuid())
  name               String
  normalizedName     String   @unique
  projectCount       Int      @default(0)
  totalExpenditure   Float    @default(0)
  averageProjectValue Float?
  districts          String?  // JSON array
  workTypes          String?  // JSON array
  concentrationScore Float?
  riskLevel          String   @default("LOW")
  isDemo             Boolean  @default(false)
  
  // Future-ready Official status
  officialStatusSource String?
  officialStatus       String?
  statusVerifiedAt     DateTime?

  // Granular contractor risk scores (Phase 4)
  contractorRiskScore  Float?   @default(0)
  contractorRiskLevel  String?  @default("LOW")
  contractorRiskSignals String? // JSON string array
  confidenceScore      Float?   @default(0)

  createdAt          DateTime @default(now())
}

// ─── Reference Prices ────────────────────────────────

model ReferencePrice {
  id             String   @id @default(uuid())
  item           String
  specification  String?
  unit           String?
  region         String?
  period         String?
  referencePrice Float
  source         String   // "CPWD SSR 2024" or "DEMO - synthetic benchmark"
  isDemo         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

// ─── Human Feedback / Active Learning ────────────────

model Feedback {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  modelVersion     String   @default("v1.0-nirman-ensemble")
  overallRiskScore Float    @default(0)
  riskLevel        String   @default("LOW")
  aiPrediction     String?  // JSON string: preserves exact state of AI findings, scores, and signals at review time
  modelType        String   @default("OVERALL") // FINANCIAL | PROCUREMENT | CONTRACTOR | OVERALL
  prediction       String?  // legacy alias
  officerDecision  String   // CONFIRMED | FALSE_POSITIVE | REQUIRES_INVESTIGATION | INSUFFICIENT_DATA
  decisionReason   String?  // legacy alias
  reason           String?  // officer justification / verification evidence
  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
}

// ─── Cases & Investigation ───────────────────────────

model Case {
  id               String       @id @default(uuid())
  caseNumber       String       @unique
  projectId        String
  project          Project      @relation(fields: [projectId], references: [id])
  title            String
  priority         String       @default("MEDIUM")
  status           String       @default("OPEN")
  assignedRole     String       @default("DISTRICT")
  assignedState    String?
  assignedDistrict String?
  createdById      String
  createdBy        User         @relation("CreatedBy", fields: [createdById], references: [id])
  actions          CaseAction[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model CaseAction {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  notes     String?
  createdAt DateTime @default(now())
}

// ─── Audit Trail ─────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  action    String
  entity    String
  details   String
  ipAddress String?
  timestamp DateTime @default(now())
}

// ─── Model Versioning & Registry ─────────────────────

model ModelVersion {
  id                String    @id @default(uuid())
  name              String    @default("NIRMAN Risk Model")
  version           String    @unique
  algorithm         String    @default("Ensemble (Statistical + IF + NLP + Rule)")
  modelType         String    @default("HYBRID_UNSUPERVISED") // HYBRID_UNSUPERVISED | SUPERVISED_BINARY | SUPERVISED_MULTICLASS
  status            String    @default("PRODUCTION") // TRAINING | EVALUATION | CANDIDATE | APPROVED | REJECTED | PRODUCTION
  datasetVersion    String?   @default("master_features_v1.0")
  featureVersion    String?   @default("features_v1.0")
  trainingDate      DateTime? @default(now())
  metrics           String?   // JSON object: { precision, recall, f1, fpr, rocAuc, confusionMatrix }
  config            String?   // JSON object: hyperparameters, feature list, weights
  f1Score           Float?
  precision         Float?
  recall            Float?
  falsePositiveRate Float?
  rocAuc            Float?
  confusionMatrix   String?   // JSON string
  isActive          Boolean   @default(false)
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
}

model Anomaly {
  id                String   @id @default(uuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id])
  anomalyType       String
  severity          String   // e.g. LOW, MEDIUM, HIGH
  scoreContribution Float
  title             String
  explanation       String
  supportingMetric  String
  createdAt         DateTime @default(now())
}
