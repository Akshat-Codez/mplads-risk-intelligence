# ==============================================================================
# NIRMAN MPLADS Risk Intelligence System — Git Ignore Configuration
# ==============================================================================

# Node.js dependencies & package manager caches
node_modules/
**/node_modules/
.pnpm-store/
.yarn/
*.local

# Production build outputs & bundler caches
dist/
dist-ssr/
build/
frontend/dist/
frontend/dist-ssr/
.vite/
frontend/.vite/
**/.vite/
.parcel-cache/
.next/
.turbo/

# Logs & debugging output
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python virtual environments & bytecode caches
__pycache__/
/**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
.tox/

# AI / ML binary artifacts & checkpoints
*.onnx
*.pt
*.pth
*.h5
*.pkl
*.joblib
*.bin
*.model
checkpoints/

# Local databases & transient SQLite files
*.db
*.sqlite
*.sqlite3
*.db-journal
backend/prisma/dev.db
backend/prisma/dev.db-journal
backend/prisma/*.db
backend/prisma/*.db-journal

# Temporary Uploads & OCR Output
uploads/
backend/uploads/*.pdf
backend/uploads/*.png
backend/uploads/*.jpg
backend/uploads/*.jpeg
ocr_output/
extracted/
temp/
tmp/

# Stale / Duplicate nested subfolders (canonical versions at root)
frontend/backend/
frontend/ai_services/
frontend/ml/
frontend/scripts/
frontend/docs/
frontend/tests/
frontend/data/
frontend/data_inventory.json
frontend/.gitignore
frontend/README.md

# Environment configurations & secrets (Preserve .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
!.env.example
!backend/.env.example

# IDE, Editor & OS metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.tmp
*.bak
scratch/
